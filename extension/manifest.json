{
  "manifest_version": 3,
  "name": "LeetCode GitHub Sync",
  "version": "1.0.0",
  "description": "Pushes accepted LeetCode submissions straight to a GitHub repo, organized by topic.",
  "permissions": ["cookies", "storage", "alarms"],
  "host_permissions": ["https://leetcode.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "options.html"
  },
  "options_page": "options.html"
}
