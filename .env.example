# Required for sync.js. Get both values from leetcode.com browser cookies.
LEETCODE_SESSION=
LEETCODE_CSRF_TOKEN=

# Required only by refresh-session.mjs after an authentication failure.
LEETCODE_USERNAME=
LEETCODE_PASSWORD=

# Required only in GitHub Actions to update repository Actions secrets.
# Use a fine-grained PAT with repository Actions secrets: write.
GH_SECRETS_TOKEN=

# Required only when running refresh-session.mjs outside GitHub Actions.
GITHUB_REPOSITORY=zk19604/leetcode-script
